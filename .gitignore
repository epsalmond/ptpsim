/target
**/*.rs.bk
Cargo.lock.orig

# SwiftPM scratch dir — created when SPM tools probe the root Package.swift.
/.build/
# xcframework / wheel / data tarball output from ci/build-xcframework.sh.
/out/

# Python (tools/protocol-mapper)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.coverage
*.egg-info/

# Python wheel build output for packages/camera-protocol-python.
# Only pyproject.toml / setup.py / README.md are committed; src/, build/,
# dist/ are assembled at build time by ci/build-python-wheel.sh.
/packages/camera-protocol-python/src/
/packages/camera-protocol-python/build/
/packages/camera-protocol-python/dist/

# OS
.DS_Store

# Raw captures / evidence MUST NOT enter this (public) repo. Only minimal,
# redacted golden packets belong here, under packages/camera-config-data. Raw

*.pcap
*.pcapng
*.cap
*.mon
*.pcapng.gz
frida_messages.jsonl
*tcpdump*
# Probe session artifacts (request/data/response dumps, decoded traces).
**/captures/
**/sessions/
*.raw.bin

# Local credentials (PAT for gh / CI) — never commit
.env
.ENV
