        "kind",
        "schema",
        "runId",
        "recordId",
        "ordinal",
        "context",
        "time",
        "epistemic",
        "marker"
      ]
    },
    {
      "type": "object",
      "properties": {
        "artifactRanges": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRange"
          }
        },
        "characteristic": {
          "type": "string"
        },
        "connectionInstance": {
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/ExecutionContext"
        },
        "epistemic": {
          "$ref": "#/$defs/EpistemicMetadata"
        },
        "kind": {
          "type": "string",
          "const": "bleGatt"
        },
        "operation": {
          "$ref": "#/$defs/BleGattOperation"
        },
        "ordinal": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "outcome": {
          "$ref": "#/$defs/TransportOutcome"
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/PayloadMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "physicalContext": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "recordId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/ClockPoint"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schema",
        "runId",
        "recordId",
        "ordinal",
        "context",
        "time",
        "epistemic",
        "connectionInstance",
        "operation",
        "service",
        "characteristic",
        "outcome"
      ]
    },
    {
      "type": "object",
      "properties": {
        "artifactRanges": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRange"
          }
        },
        "connectionInstance": {
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/ExecutionContext"
        },
        "endpointSet": {
          "type": "string"
        },
        "epistemic": {
          "$ref": "#/$defs/EpistemicMetadata"
        },
        "evidenceBasis": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlEvidenceBasis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "type": "string",
          "const": "ptpTransaction"
        },
        "observedEffect": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlObservedEffect"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ordinal": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "outcome": {
          "$ref": "#/$defs/TransactionOutcome"
        },
        "physicalContext": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "readback": {
          "anyOf": [
            {
              "$ref": "#/$defs/Readback"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recordId": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/PtpRequest"
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/PtpResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runId": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/ClockPoint"
        },
        "transactionId": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "transport": {
          "$ref": "#/$defs/PtpTransport"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schema",
        "runId",
        "recordId",
        "ordinal",
        "context",
        "time",
        "epistemic",
        "transport",
        "connectionInstance",
        "session",
        "endpointSet",
        "transactionId",
        "request",
        "outcome"
      ]
    },
    {
      "type": "object",
      "properties": {
        "artifactRanges": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRange"
          }
        },
        "connectionInstance": {
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/ExecutionContext"
        },
        "endpointSet": {
          "type": "string"
        },
        "epistemic": {
          "$ref": "#/$defs/EpistemicMetadata"
        },
        "event": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "ptpEvent"
        },
        "ordinal": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "parameters": {
          "type": "array",
          "default": [],
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/PayloadMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "physicalContext": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "recordId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/ClockPoint"
        },
        "transactionId": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "transactionRecordId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schema",
        "runId",
        "recordId",
        "ordinal",
        "context",
        "time",
        "epistemic",
        "connectionInstance",
        "session",
        "endpointSet",
        "transactionId",
        "event"
      ]
    },
    {
      "type": "object",
      "properties": {
        "artifactRanges": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRange"
          }
        },
        "connectionInstance": {
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/ExecutionContext"
        },
        "epistemic": {
          "$ref": "#/$defs/EpistemicMetadata"
        },
        "kind": {
          "type": "string",
          "const": "httpExchange"
        },
        "ordinal": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "outcome": {
          "$ref": "#/$defs/TransportOutcome"
        },
        "physicalContext": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "recordId": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/HttpRequest"
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runId": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/ClockPoint"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schema",
        "runId",
        "recordId",
        "ordinal",
        "context",
        "time",
        "epistemic",
        "connectionInstance",
        "request",
        "outcome"
      ]
    },
    {
      "type": "object",
      "properties": {
        "artifactRanges": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRange"
          }
        },
        "context": {
          "$ref": "#/$defs/ExecutionContext"
        },
        "epistemic": {
          "$ref": "#/$defs/EpistemicMetadata"
        },
        "evidenceBasis": {
          "$ref": "#/$defs/ControlEvidenceBasis"
        },
        "inventoryCompleteness": {
          "description": "Completeness of the operation or property inventory in this record's\nexact camera + execution context. Omitted observations are partial and\ntherefore cannot support negative capability assertions.",
          "$ref": "#/$defs/InventoryCompleteness"
        },
        "kind": {
          "type": "string",
          "const": "capability"
        },
        "observedEffect": {
          "$ref": "#/$defs/ControlObservedEffect"
        },
        "ordinal": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "physicalContext": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "readback": {
          "$ref": "#/$defs/Readback"
        },
        "recordId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/CapabilitySubject"
        },
        "time": {
          "$ref": "#/$defs/ClockPoint"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schema",
        "runId",
        "recordId",
        "ordinal",
        "context",
        "time",
        "epistemic",
        "subject",
        "evidenceBasis",
        "observedEffect",
        "readback"
      ]
    },
    {
      "type": "object",
      "properties": {
        "actionId": {
          "type": "string"
        },
        "artifactRanges": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRange"
          }
        },
        "catalogRevision": {
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/ExecutionContext"
        },
        "epistemic": {
          "$ref": "#/$defs/EpistemicMetadata"
        },
        "kind": {
          "type": "string",
          "const": "actionInvocation"
        },
        "ordinal": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "outcome": {
          "$ref": "#/$defs/ActionOutcome"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "physicalContext": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "recordId": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ActionRole"
        },
