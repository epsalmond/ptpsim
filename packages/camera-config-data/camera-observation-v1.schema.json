        "catalogRevision",
        "actionId",
        "role",
        "parameters",
        "outcome"
      ]
    }
  ],
  "$defs": {
    "ActionOutcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "rejected"
      ]
    },
    "ActionRole": {
      "type": "string",
      "enum": [
        "initiator",
        "responder"
      ]
    },
    "ArtifactMetadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "length": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mediaType": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "length",
        "sha256",
        "mediaType"
      ]
    },
    "ArtifactRange": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string"
        },
        "length": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "artifact",
        "offset",
        "length"
      ]
    },
    "AssertionProvenance": {
      "description": "Assertion-level provenance. This is separate from the enclosing record's\ncapture provenance because one capability record may carry independently\nsourced names and value rows.",
      "type": "object",
      "properties": {
        "epistemic": {
          "$ref": "#/$defs/EpistemicMetadata"
        },
        "evidenceReference": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "evidenceReference",
        "epistemic"
      ]
    },
    "BleGattOperation": {
      "type": "string",
      "enum": [
        "discover",
        "read",
        "write",
        "subscribe",
        "notify",
        "indicate"
      ]
    },
    "CameraContext": {
      "type": "object",
      "properties": {
        "bodyId": {
          "description": "Sanitized stable pseudonym for the physical body; never a serial number.",
          "type": "string"
        },
        "firmware": {
          "type": "string"
        },
        "manufacturer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "manufacturer",
        "model",
        "bodyId",
        "firmware"
      ]
    },
    "CapabilityDescriptor": {
      "type": "object",
      "properties": {
        "form": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "default": [],
          "items": true
        }
      },
      "additionalProperties": false,
      "required": [
        "form"
      ]
    },
    "CapabilitySubject": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "deviceVersion": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "identity"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "deviceVersion"
          ]
        },
        {
          "type": "object",
          "properties": {
            "canonicalName": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SemanticNameAssertion"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "code": {
              "type": "string"
            },
            "supported": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "operation"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "code",
            "supported"
          ]
        },
        {
          "type": "object",
          "properties": {
            "access": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "canonicalName": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SemanticNameAssertion"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "code": {
              "type": "string"
            },
            "descriptor": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CapabilityDescriptor"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            },
            "propertyType": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "sourceNativeName": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SemanticNameAssertion"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "supported": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "property"
            },
            "valueProfiles": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/CapabilityValueProfile"
              }
            },
            "valueRows": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/CapabilityValueRow"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "code",
            "supported"
          ]
        }
      ]
    },
    "CapabilityValueProfile": {
      "type": "object",
      "properties": {
        "connection": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "evidence": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityValueProfileRow"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "rows"
      ]
    },
    "CapabilityValueProfileRow": {
      "type": "object",
      "properties": {
        "aliases": {
          "type": "array",
          "default": [],
          "items": {
            "type": "integer",
            "format": "int64"
          }
        },
        "label": {
          "type": "string"
        },
        "legal": {
          "type": "boolean",
          "default": true
        },
        "raw": {
          "type": "integer",
          "format": "int64"
        },
        "writeStoreRaw": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "raw"
      ]
    },
    "CapabilityValueRow": {
      "description": "A global property-value semantic assertion. The tagged value preserves the\ndeclared PTP representation without routing wide integers through JSON\nfloating-point numbers.",
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/AssertionProvenance"
        },
        "value": {
          "$ref": "#/$defs/TypedPropertyValue"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "label",
        "provenance"
      ]
    },
    "CaptureClock": {
      "type": "object",
      "properties": {
        "clockType": {
          "$ref": "#/$defs/ClockType"
        },
        "id": {
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/ClockUnit"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "clockType",
        "unit"
      ]
    },
    "CaptureContext": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactMetadata"
          }
        },
        "clockMappings": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ClockMapping"
          }
        },
        "clocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaptureClock"
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaptureInterface"
          }
        },
        "loss": {
          "$ref": "#/$defs/LossCounters"
        },
        "redactions": {
          "type": "array",
