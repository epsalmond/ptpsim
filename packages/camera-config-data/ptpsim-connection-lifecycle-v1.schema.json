              "const": "unconfirmed"
            },
            "value": {
              "$ref": "#/$defs/CommandListenerState"
            }
          },
          "additionalProperties": false,
          "required": [
            "evidence",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "evidence": {
              "type": "string",
              "const": "confirmed"
            },
            "value": {
              "$ref": "#/$defs/CommandListenerState"
