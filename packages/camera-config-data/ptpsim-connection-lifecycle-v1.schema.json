    "NetworkPersonaState": {
      "type": "string",
      "enum": [
        "ready",
        "exited"
      ]
    },
    "ProxyTransportState": {
      "type": "string",
      "enum": [
        "accepted",
        "commandInitialized",
        "lost",
        "locallyClosed"
      ]
    },
    "PtpSessionState": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    }
  }
