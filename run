#!/usr/bin/env bash
# Build and run camera-sim-service locally as a believable GFX100 II PTP/IP camera.
#
# Local dev loop: a bare `./run` builds the service (debug) and serves it on loopback
# with the committed GFX100 II manifest + sample media/live-view fixtures, so an iOS
# simulator (or a real client) can connect to it as a "network camera". This is the
# native counterpart to the Docker image the CI/App-Review path uses; it depends only
# on a Rust toolchain.
#
# Idempotent: if a healthy instance is already listening on the control port, this
# prints its address and exits 0 rather than starting a second one (avoids the
# duplicate-launch the client application `./run` integration would otherwise cause).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Overridable knobs. Defaults mirror the Dockerfile CMD + main.rs, repo-relative.
PROFILE="${PTPSIM_PROFILE:-fuji/gfx100ii}"
INSTANCE_ID="${PTPSIM_INSTANCE_ID:-local}"
CONNECTION="${PTPSIM_CONNECTION:-app}"
MANIFEST="${PTPSIM_MANIFEST:-$SCRIPT_DIR/packages/camera-config-data/fuji/gfx100ii/gfx100ii.consolidated.yaml}"
MEDIA_ROOT="${PTPSIM_MEDIA_ROOT:-$SCRIPT_DIR/packages/fixtures/gfx100ii}"
LIVEVIEW_DIR="${PTPSIM_LIVEVIEW_DIR:-$SCRIPT_DIR/packages/fixtures/liveview/640x480}"

# Binds. Loopback by default so a local simulator reaches them; override to [::]:…
# / 0.0.0.0:… to expose to other hosts. Control stays loopback unless overridden.
case "$CONNECTION" in
  app)
    DEFAULT_COMMAND_BIND="127.0.0.1:55740"
    DEFAULT_EVENT_BIND="127.0.0.1:55741"
    DEFAULT_LIVEVIEW_BIND="127.0.0.1:55742"
    ;;
  wireless-tether)
    DEFAULT_COMMAND_BIND="127.0.0.1:15740"
    DEFAULT_EVENT_BIND=""
    DEFAULT_LIVEVIEW_BIND=""
    ;;
  *)
    DEFAULT_COMMAND_BIND=""
    DEFAULT_EVENT_BIND=""
    DEFAULT_LIVEVIEW_BIND=""
    ;;
esac
COMMAND_BIND="${PTPSIM_COMMAND_BIND:-$DEFAULT_COMMAND_BIND}"
EVENT_BIND="${PTPSIM_EVENT_BIND:-$DEFAULT_EVENT_BIND}"
LIVEVIEW_BIND="${PTPSIM_LIVEVIEW_BIND:-$DEFAULT_LIVEVIEW_BIND}"
CONTROL_BIND="${PTPSIM_CONTROL_BIND:-127.0.0.1:8080}"

CARGO_PROFILE="${PTPSIM_CARGO_PROFILE:-debug}"  # debug | release

# Optional observer URL (#126): when set, the sim POSTs a camera-state snapshot here on change.
# The client application dev panel hosts the receiver at .../state; unset = no callback.
STATE_CALLBACK="${PTPSIM_STATE_CALLBACK:-}"

# host:port of the command socket — what a PTP/IP client connects to.
COMMAND_HOST="${COMMAND_BIND%:*}"
COMMAND_PORT="${COMMAND_BIND##*:}"
CONTROL_HOST="${CONTROL_BIND%:*}"
CONTROL_PORT="${CONTROL_BIND##*:}"
# `curl` to a bare `::`/`0.0.0.0` bind must target loopback.
probe_host() { case "$1" in "::"|"0.0.0.0"|"") echo "127.0.0.1" ;; *) echo "$1" ;; esac; }
HEALTH_URL="http://$(probe_host "$CONTROL_HOST"):$CONTROL_PORT/healthz"

healthcheck() { curl -fsS --max-time 1 "$HEALTH_URL" >/dev/null 2>&1; }

# Idempotency: bail out cleanly if an instance is already serving this control port.
if healthcheck; then
  echo "ptpsim already healthy at $HEALTH_URL — not starting a second instance."
  echo "Connect a PTP/IP client to ${COMMAND_HOST}:${COMMAND_PORT}"
  curl -fsS --max-time 1 "$HEALTH_URL" 2>/dev/null || true
  echo
  exit 0
fi

for f in "$MANIFEST" "$MEDIA_ROOT"; do
  [[ -e "$f" ]] || { echo "Missing required path: $f" >&2; exit 1; }
done

echo "Building camera-sim-service ($CARGO_PROFILE)..."
cargo_build_args=(build -p camera-sim-service)
bin_dir="target/debug"
if [[ "$CARGO_PROFILE" == "release" ]]; then
  cargo_build_args+=(--release)
  bin_dir="target/release"
fi
cargo "${cargo_build_args[@]}"

BIN="$SCRIPT_DIR/$bin_dir/camera-sim-service"
[[ -x "$BIN" ]] || { echo "Built binary not found: $BIN" >&2; exit 1; }

run_args=(
  --profile "$PROFILE"
  --instance-id "$INSTANCE_ID"
  --connection "$CONNECTION"
  --manifest "$MANIFEST"
  --media-root "$MEDIA_ROOT"
  --control-bind "$CONTROL_BIND"
)
if [[ -n "$COMMAND_BIND" ]]; then
  run_args+=(--command-bind "$COMMAND_BIND")
fi
if [[ -n "$EVENT_BIND" ]]; then
  run_args+=(--event-bind "$EVENT_BIND")
fi
if [[ -n "$LIVEVIEW_BIND" ]]; then
  run_args+=(--liveview-bind "$LIVEVIEW_BIND")
fi
if [[ -d "$LIVEVIEW_DIR" ]]; then
  run_args+=(--liveview-dir "$LIVEVIEW_DIR")
else
  echo "Note: live-view dir not found ($LIVEVIEW_DIR); serving without live-view frames."
fi
if [[ -n "$STATE_CALLBACK" ]]; then
  run_args+=(--state-callback "$STATE_CALLBACK")
fi

echo
echo "Starting ptpsim camera simulator"
echo "  profile:    $PROFILE"
echo "  connection: $CONNECTION"
echo "  manifest:   $MANIFEST"
echo "  media-root: $MEDIA_ROOT"
echo "  control:    $HEALTH_URL"
[[ -n "$STATE_CALLBACK" ]] && echo "  state →     $STATE_CALLBACK"
echo "  >> Connect a PTP/IP network camera to ${COMMAND_HOST}:${COMMAND_PORT} <<"
echo
exec "$BIN" "${run_args[@]}"
