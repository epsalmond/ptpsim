#!/bin/zsh
set -euo pipefail

repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
repo_root="$(cd "$repo_dir/.." && pwd)"
cd "$repo_dir"

usage() {
    cat >&2 <<'USAGE'
usage:
  tools/bt-local list
  tools/bt-local forget <name-or-id>
  tools/bt-local probe <probe-args...>

probe examples:
  tools/bt-local probe pair-state 38-7c-76-74-73-21
USAGE
}

cmd="${1:-list}"
shift || true

case "$cmd" in
    list)
        exec ./bluetooth-wrapper
        ;;
    forget)
        if [[ $# -ne 1 ]]; then
            usage
            exit 64
        fi
        exec ./bluetooth-wrapper forget "$1"
        ;;
    probe)
        if [[ $# -lt 1 ]]; then
            usage
            exit 64
        fi
        probe_binary="$("$repo_root/scripts/build/build-bluetooth-wrapper.sh" --probe-only)"
        exec "$probe_binary" "$@"
        ;;
    *)
        usage
        exit 64
        ;;
esac
