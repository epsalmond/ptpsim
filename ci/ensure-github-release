#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
  echo "usage: ci/ensure-github-release TAG TARGET_COMMIT" >&2
  exit 2
fi

tag="$1"
target_commit="$2"

release_exists() {
  gh release view "$tag" >/dev/null 2>&1
}

if release_exists; then
  exit 0
fi

if gh release create "$tag" \
  --target "$target_commit" \
  --title "ptpsim FFI $tag" \
  --notes "Auto-built artifacts."; then
  exit 0
fi

if ! release_exists; then
  echo "could not create or observe release $tag" >&2
  exit 1
fi
